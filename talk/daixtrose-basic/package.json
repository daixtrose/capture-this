{
    "name": "slidev-theme-daixtrose-basic",
    "version": "1.0.0",
    "private": true,
    "description": "Daixtrose basic theme for Slidev with Atkinson Hyperlegible Next and Intel One Mono fonts",
    "keywords": [
        "slidev-theme",
        "slidev"
    ],
    "engines": {
        "slidev": ">=0.50.0 || >=52.0.0"
    },
    "slidev": {
        "colorSchema": "both",
        "defaults": {
            "fonts": {
                "sans": "Atkinson Hyperlegible Next",
                "mono": "Intel One Mono",
                "local": "Atkinson Hyperlegible Next,Intel One Mono",
                "provider": "none"
            }
        }
    },
    "dependencies": {
        "@slidev/theme-default": "latest"
    }
}